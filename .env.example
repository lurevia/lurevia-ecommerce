NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=Lurevia
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lurevia?schema=public

JWT_ACCESS_SECRET=your-32-character-jwt-access-secret-key-here
JWT_REFRESH_SECRET=your-32-character-jwt-refresh-secret-key-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGINS=*
COOKIE_DOMAIN=
COOKIE_SECURE=false

BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=50
ADMIN_RATE_LIMIT_MAX=1000
CIN_RATE_LIMIT_MAX=20

LOG_LEVEL=info

DEFAULT_SHIPPING_COST=8000
FREE_SHIPPING_THRESHOLD=250000
REVIEW_DELAY_DAYS=5

AUCTION_ANTI_SNIPE_MINUTES=2
AUCTION_DEFAULT_DURATION_HOURS=24
AUCTION_MIN_INCREMENT=1000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_MEDIA_TOKEN=
GITHUB_MEDIA_OWNER=lurevia
GITHUB_MEDIA_REPO=lurevia-media
GITHUB_MEDIA_BRANCH=main
GITHUB_MEDIA_PATH=media
MEDIA_MAX_BYTES=10485760

# Maps & Geolocation
# MAPS_PROVIDER: "openstreetmap" (100% free, no key needed), "serpapi" (uses SerpApi Google Local API), or "google"
MAPS_PROVIDER=openstreetmap
GOOGLE_MAPS_API_KEY=
SERPAPI_API_KEY=

MVOLA_MERCHANT_NUMBER=
MVOLA_API_URL=
MVOLA_API_KEY=
MVOLA_API_SECRET=
MVOLA_CALLBACK_URL=

ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_API_URL=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
ORANGE_MONEY_CALLBACK_URL=

AIRTEL_MONEY_MERCHANT_ID=
AIRTEL_MONEY_API_URL=
AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_API_SECRET=
AIRTEL_MONEY_CALLBACK_URL=
