// ═══════════════════════════════════════════════════════════════════════════
// MODULE : BUSINESS VENDEUR, COMMISSIONS & PAIEMENTS
// Règle : Un table = un seul rôle, comptabilité propre
// ═══════════════════════════════════════════════════════════════════════════

// ── 1. CONTRAT COMMERCIAL (Conditions et commissions négociées) ──
model SellerContract {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId        String               @db.Uuid
  seller          User                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  version         Int
  type            SellerContractType
  value           Int
  currency        String               @default("MGA") @db.VarChar(10)
  status          SellerContractStatus @default(PENDING)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  rejectionReason String?              @db.VarChar(255)
  reviewedBy      String?              @db.Uuid
  reviewedAt      DateTime?

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  settlements     SellerSettlement[]

  @@unique([sellerId, version])
  @@index([sellerId, status, effectiveFrom])
  @@map("seller_contracts")
}

// ── 2. DÉCOMPTE DE RÈGLEMENT PAR COMMANDE (Calcul de commission) ──
model SellerSettlement {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String           @db.Uuid
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId         String           @db.Uuid
  seller           User             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  contractId       String?          @db.Uuid
  contract         SellerContract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  contractVersion  Int?

  grossAmount      Int
  commissionAmount Int
  netAmount        Int
  status           SettlementStatus @default(PENDING_REVIEW)
  reviewNote       String?          @db.VarChar(255)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  transfers        TransferLedger[]

  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt])
  @@index([orderId])
  @@map("seller_settlements")
}

// ── 3. GRAND LIVRE DES VIREMENTS (Paiements envoyés aux vendeurs) ──
model TransferLedger {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlementId      String           @db.Uuid
  settlement        SellerSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  sellerId          String           @db.Uuid
  seller            User             @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  amount            Int
  currency          String           @default("MGA") @db.VarChar(10)
  idempotencyKey    String           @unique @db.VarChar(128)
  status            TransferStatus   @default(PENDING)
  externalReference String?          @db.VarChar(120)
  failureReason     String?          @db.VarChar(255)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  completedAt       DateTime?

  @@index([sellerId, status, createdAt])
  @@index([settlementId])
  @@map("transfer_ledger")
}
