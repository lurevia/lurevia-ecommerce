// ═══════════════════════════════════════════════════════════════════════════
// MODULE : PARAMÈTRES GLOBAUX DE LA PLATEFORME (SETTINGS)
// Règle : Singletons typés, 1 table = 1 domaine de configuration
// ═══════════════════════════════════════════════════════════════════════════

// ── 1. COMPATIBILITÉ RÉTROACTIVE : TABLE GLOBALE DES PARAMÈTRES ──
model PlatformSettings {
  id                       String   @id @default("singleton")
  siteName                 String   @default("Lurevia") @db.VarChar(100)
  siteTagline              String?  @db.VarChar(160)
  siteDescription          String?  @db.Text
  contactEmail             String?  @db.VarChar(120)
  contactPhone             String?  @db.VarChar(30)
  contactAddress           String?  @db.VarChar(255)
  defaultCurrency          String   @default("MGA") @db.VarChar(10)

  logoUrl                  String?  @db.VarChar(500)
  faviconUrl               String?  @db.VarChar(500)
  primaryColor             String   @default("#2F7BF6") @db.VarChar(10)
  secondaryColor           String   @default("#0A1B3D") @db.VarChar(10)
  accentColor              String?  @db.VarChar(10)

  facebookUrl              String?  @db.VarChar(255)
  instagramUrl             String?  @db.VarChar(255)
  tiktokUrl                String?  @db.VarChar(255)
  whatsappNumber           String?  @db.VarChar(30)
  linkedinUrl              String?  @db.VarChar(255)

  privacyPolicy            String   @default("") @db.Text
  termsOfService           String   @default("") @db.Text
  cookieMessage            String   @default("") @db.VarChar(255)
  legalCompanyName         String?  @db.VarChar(160)
  legalRegistrationNumber  String?  @db.VarChar(60)

  freeShippingThreshold    Int      @default(250000)
  defaultShippingCost      Int      @default(8000)
  homeDeliveryEnabled      Boolean  @default(true)
  pickupPointEnabled       Boolean  @default(true)

  enableMVola              Boolean  @default(true)
  enableCOD                Boolean  @default(true)
  enableCard               Boolean  @default(false)
  enableBankTransfer       Boolean  @default(false)
  codMaxAmount             Int?     @default(500000)

  requireCinForSellers     Boolean  @default(true)
  requireCinForCOD         Boolean  @default(false)
  cinVerificationEnabled   Boolean  @default(true)
  allowMinorWithGuardian   Boolean  @default(true)
  minorAgeThreshold        Int      @default(18)

  auctionsEnabled          Boolean  @default(true)
  auctionMinIncrement      Int      @default(1000)
  auctionAutoExtendMinutes Int      @default(2)
  auctionDefaultDurationH  Int      @default(24)
  auctionChatEnabled       Boolean  @default(true)
  auctionChatModeration    Boolean  @default(true)

  metaTitle                String?  @db.VarChar(70)
  metaDescription          String?  @db.VarChar(160)

  maintenanceMode          Boolean  @default(false)
  maintenanceMessage       String?  @db.VarChar(255)

  updatedAt                DateTime @updatedAt
  updatedBy                String?  @db.Uuid

  @@map("platform_settings")
}

// ── 2. NOUVELLE ARCHITECTURE MODULAIRE : IDENTITÉ DU SITE ──
model SiteIdentitySettings {
  id                  String   @id @default("singleton")
  siteName            String   @default("Lurevia") @db.VarChar(100)
  tagline             String?  @db.VarChar(160)
  description         String?  @db.Text
  contactEmail        String?  @db.VarChar(120)
  contactPhone        String?  @db.VarChar(30)
  companyName         String?  @db.VarChar(160)
  companyAddress      String?  @db.VarChar(255)
  companyRegistration String?  @db.VarChar(60)
  defaultLocale       String   @default("fr") @db.VarChar(10)
  defaultCurrency     String   @default("MGA") @db.VarChar(10)
  timezone            String   @default("Indian/Antananarivo") @db.VarChar(50)

  updatedAt           DateTime @updatedAt
  updatedBy           String?  @db.Uuid

  @@map("site_identity_settings")
}

// ── 3. CHARTE GRAPHIQUE ET THÈME ──
model ThemeSettings {
  id              String   @id @default("singleton")
  logoUrl         String?  @db.VarChar(500)
  faviconUrl      String?  @db.VarChar(500)
  primaryColor    String   @default("#000000") @db.VarChar(10)
  secondaryColor  String   @default("#FFFFFF") @db.VarChar(10)
  accentColor     String?  @db.VarChar(10)
  backgroundColor String?  @db.VarChar(10)
  textColor       String?  @db.VarChar(10)
  fontFamily      String?  @db.VarChar(60)
  darkModeEnabled Boolean  @default(false)

  updatedAt       DateTime @updatedAt
  updatedBy       String?  @db.Uuid

  @@map("theme_settings")
}

// ── 4. RÉSEAUX SOCIAUX OFFICIELS ──
model SocialLink {
  id        String         @id @default(cuid())
  platform  SocialPlatform
  label     String?        @db.VarChar(60)
  url       String         @db.VarChar(255)
  isActive  Boolean        @default(true)
  position  Int            @default(0)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  updatedBy String?        @db.Uuid

  @@unique([platform, label])
  @@index([isActive, position])
  @@map("social_links")
}

// ── 5. SEO GLOBAL DE LA PLATEFORME ──
model SeoSettings {
  id                 String   @id @default("singleton")
  defaultTitle       String?  @db.VarChar(70)
  titleTemplate      String?  @db.VarChar(100)
  defaultDescription String?  @db.VarChar(160)
  defaultKeywords    String[] @default([])
  defaultOgImageUrl  String?  @db.VarChar(500)
  canonicalBaseUrl   String?  @db.VarChar(255)
  robotsIndex        Boolean  @default(true)
  robotsFollow       Boolean  @default(true)

  updatedAt          DateTime @updatedAt
  updatedBy          String?  @db.Uuid

  @@map("seo_settings")
}

// ── 6. DISPONIBILITÉ & MODE MAINTENANCE ──
model MaintenanceSettings {
  id               String    @id @default("singleton")
  isEnabled        Boolean   @default(false)
  message          String?   @db.VarChar(255)
  expectedEndAt    DateTime?
  allowAdminAccess Boolean   @default(true)

  updatedAt        DateTime  @updatedAt
  updatedBy        String?   @db.Uuid

  @@map("maintenance_settings")
}

// ── 7. DOCUMENTS JURIDIQUES & CGV/CGU ──
model LegalDocument {
  id                 String            @id @default(cuid())
  type               LegalDocumentType
  provider           DocumentProvider
  status             DocumentStatus    @default(DRAFT)
  locale             String            @default("fr") @db.VarChar(10)
  title              String            @db.VarChar(140)
  description        String?           @db.VarChar(255)

  documentUrl        String            @db.VarChar(500)
  externalDocumentId String?           @db.VarChar(120)

  version            Int               @default(1)
  isCurrent          Boolean           @default(false)
  publishedAt        DateTime?
  archivedAt         DateTime?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  createdBy          String?           @db.Uuid
  updatedBy          String?           @db.Uuid

  @@unique([type, locale, version])
  @@index([type, locale, status])
  @@index([type, locale, isCurrent])
  @@map("legal_documents")
}

// ── 8. PARAMÈTRES GLOBAUX DE LIVRAISON ──
model ShippingSettings {
  id                       String   @id @default("singleton")
  shippingEnabled          Boolean  @default(true)
  freeShippingEnabled      Boolean  @default(false)
  freeShippingMinAmount    Decimal? @db.Decimal(12, 2)
  defaultShippingFee       Decimal  @default(0) @db.Decimal(12, 2)
  estimatedMinDays         Int?
  estimatedMaxDays         Int?
  allowShippingCalculation Boolean  @default(true)

  updatedAt                DateTime @updatedAt
  updatedBy                String?  @db.Uuid

  @@map("shipping_settings")
}

// ── 9. MODES DE PAIEMENT ──
model PaymentMethodSettings {
  id             String   @id @default("singleton")
  cashOnDelivery Boolean  @default(true)
  mobileMoney    Boolean  @default(false)
  bankTransfer   Boolean  @default(false)
  cardPayment    Boolean  @default(false)
  codMaxAmount   Decimal? @db.Decimal(12, 2)

  updatedAt      DateTime @updatedAt
  updatedBy      String?  @db.Uuid

  @@map("payment_method_settings")
}

// ── 10. VÉRIFICATION DES MARCHANDS ──
model SellerVerificationSettings {
  id                       String   @id @default("singleton")
  verificationRequired     Boolean  @default(true)
  cinVerificationRequired  Boolean  @default(true)
  manualReviewRequired     Boolean  @default(true)
  allowUnverifiedSelling   Boolean  @default(false)
  requireVerifiedForPayout Boolean  @default(true)

  updatedAt                DateTime @updatedAt
  updatedBy                String?  @db.Uuid

  @@map("seller_verification_settings")
}

// ── 11. ENCHÈRES ──
model AuctionSettings {
  id                    String   @id @default("singleton")
  auctionsEnabled       Boolean  @default(false)
  minimumDurationHours  Int      @default(24)
  maximumDurationDays   Int      @default(14)
  minimumIncrement      Decimal  @default(1000) @db.Decimal(12, 2)
  requireVerifiedSeller Boolean  @default(true)
  requireVerifiedBuyer  Boolean  @default(false)

  updatedAt             DateTime @updatedAt
  updatedBy             String?  @db.Uuid

  @@map("auction_settings")
}

// ── 12. NOTIFICATIONS ──
model NotificationSettings {
  id                    String   @id @default("singleton")
  emailEnabled          Boolean  @default(true)
  smsEnabled            Boolean  @default(false)
  pushEnabled           Boolean  @default(false)
  orderNotifications    Boolean  @default(true)
  paymentNotifications  Boolean  @default(true)
  shippingNotifications Boolean  @default(true)
  sellerNotifications   Boolean  @default(true)
  adminNotifications    Boolean  @default(true)

  updatedAt             DateTime @updatedAt
  updatedBy             String?  @db.Uuid

  @@map("notification_settings")
}

// ── 13. JOURNAL D'AUDIT DES PARAMÈTRES ──
model SettingsAuditLog {
  id        String              @id @default(cuid())
  actorId   String?             @db.Uuid
  domain    SettingsDomain
  settingId String?             @db.VarChar(50)
  action    SettingsAuditAction
  changes   Json?
  requestId String?             @db.VarChar(120)
  ipAddress String?             @db.VarChar(45)
  userAgent String?             @db.VarChar(255)

  createdAt DateTime            @default(now())

  @@index([domain, createdAt])
  @@index([actorId, createdAt])
  @@index([settingId])
  @@map("settings_audit_logs")
}
