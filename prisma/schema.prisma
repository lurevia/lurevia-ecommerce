// ════════════════════════════════════════════════════════════════════
//  LUREVIA — schema.prisma v2 (complet)
//  Marketplace où les vendeurs sont en concurrence sur le SEO et le contenu.
//
//  Organisation du fichier :
//    0. Config            7.  Commandes & paiements
//    1. Enums             8.  Feedback
//    2. Identité & auth   9.  Notifications & messages
//    3. Boutiques         10. Business vendeur
//    4. Logistique        11. Admin, audit, média
//    5. Catalogue         12. Configuration plateforme
//    6. Contenu & SEO     13. Mesures, scoring, classements, récompenses
//
//  Les anciens champs gardés "par compatibilité" sont signalés [COMPAT].
// ════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

