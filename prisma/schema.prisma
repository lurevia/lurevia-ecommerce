model User {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName       String
  email          String  @unique
  phone          String? @unique
  avatarUrl      String?
  age            Int?
  gender         Gender?
  isPrimaryAdmin Boolean @default(false)

  passwordHash      String?
  passwordChangedAt DateTime?
  primaryIdentifier AuthIdentifier @default(EMAIL)
  primaryProvider   AuthProvider   @default(LOCAL)

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)
  isVerified    Boolean @default(false)
  cinNumber                  String?                    @unique
  cinVerifiedAt              DateTime?
  identityDocumentType       IdentityDocumentType?
  identityDocumentNumber     String?                    @unique
  identityDocumentUrl        String?                    @db.Text
  identityVerifiedAt         DateTime?
  identityVerificationStatus IdentityVerificationStatus @default(NOT_SUBMITTED)
  identityRejectionReason    String?

  isMinor                Boolean           @default(false)
  guardianFullName       String?
  guardianCinNumber      String?
  guardianPhone          String?
  guardianEmail          String?
  guardianRelation       GuardianRelation?
  guardianCinDocumentUrl String?           @db.Text
  guardianCinVerifiedAt  DateTime?
  guardianConsentGivenAt DateTime?
  guardianConsentIp      String?

  role        Role      @default(CUSTOMER)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  oauthAccounts           OAuthAccount[]
  passwordResets          PasswordResetToken[]
  refreshTokens           RefreshToken[]
  verificationRequests    VerificationRequest[]
  deletionRequests        AccountDeletionRequest[]
  profileChangeRequests   ProfileChangeRequest[]
  productDeletionRequests ProductDeletionRequest[] @relation("SellerProductDeletionRequests")
  identityVerifications   IdentityVerification[]

  boutique         Boutique?         @relation("BoutiqueOwner")
  managedBoutiques ManagedBoutique[]
  subscriptions    Subscription[]

  addresses        Address[]
  cartItems        CartItem[]
  favorites        FavoriteItem[]
  orders           Order[]
  feedbacks        Feedback[]
  notifications    Notification[]
  messagesReceived UserMessage[]  @relation("MessageRecipient")
  messagesSent     UserMessage[]  @relation("MessageSender")
  auditLogs        AuditLog[]     @relation("AuditActor")

  bids            ProductBid[]
  sellerContracts SellerContract[]
  settlements     SellerSettlement[]
  transfers       TransferLedger[]
  mediaAssets     MediaAsset[]

  deliveries DeliveryTracking[] @relation("DeliveryCourier")

  auctionProductsWon Product[]         @relation("AuctionWinner")
  auctionMessages    AuctionMessage[]
  auctionWatchers    AuctionWatcher[]

  @@index([role])
  @@index([deletedAt])
  @@index([identityVerificationStatus])
  @@index([guardianCinNumber])
  @@map("users")
}

model IdentityVerification {
  id     String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String                     @db.Uuid
  user   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status IdentityVerificationStatus @default(PENDING)

  documentType    IdentityDocumentType?
  documentNumber  String?
  documentUrl     String?               @db.Text
  documentUrlBack String?               @db.Text
  selfieUrl       String?               @db.Text
  cinNumber       String?

  isGuardianVerification  Boolean           @default(false)
  guardianFullName        String?
  guardianCinNumber       String?
  guardianRelation        GuardianRelation?
  guardianCinDocumentUrl  String?           @db.Text
  guardianPhone           String?
  guardianConsentProofUrl String?           @db.Text

  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?   @db.Uuid
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([guardianCinNumber])
  @@map("identity_verifications")
}

model OAuthAccount {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  providerUserId String
  providerEmail  String?
  providerName   String?
  avatarUrl      String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String         @db.Uuid
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String         @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?        @db.Uuid
  replacedBy   RefreshToken?  @relation("TokenRotation", fields: [replacedById], references: [id])
  replaces     RefreshToken[] @relation("TokenRotation")
  createdByIp  String?
  userAgent    String?
  createdAt    DateTime       @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdByIp String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model VerificationRequest {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String             @db.Uuid
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        VerificationStatus @default(PENDING)
  codeHash      String?
  expiresAt     DateTime?
  approvedAt    DateTime?
  approvedBy    String?
  usedAt        DateTime?
  reason        String?
  attempts      Int                @default(0)
  maxAttempts   Int                @default(5)
  lastAttemptAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@map("verification_requests")
}

model AccountDeletionRequest {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String                @db.Uuid
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason      String?
  status      DeletionRequestStatus @default(PENDING)
  adminNote   String?
  createdAt   DateTime              @default(now())
  processedAt DateTime?

  @@index([status])
  @@index([userId])
  @@map("account_deletion_requests")
}

model ProfileChangeRequest {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                     @db.Uuid
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedFullName String?
  requestedEmail    String?
  requestedPhone    String?
  status            ProfileChangeRequestStatus @default(PENDING)
  adminNote         String?
  reviewedBy        String?
  createdAt         DateTime                   @default(now())
  reviewedAt        DateTime?

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("profile_change_requests")
}

model ProductDeletionRequest {
  id         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String                       @db.Uuid
  product    Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId   String                       @db.Uuid
  seller     User                         @relation("SellerProductDeletionRequests", fields: [sellerId], references: [id], onDelete: Cascade)
  reason     String                       @db.Text
  status     ProductDeletionRequestStatus @default(PENDING)
  adminNote  String?                      @db.Text
  reviewedBy String?                      @db.Uuid
  createdAt  DateTime                     @default(now())
  reviewedAt DateTime?

  @@index([status, createdAt])
  @@index([sellerId, status])
  @@index([productId, status])
  @@map("product_deletion_requests")
}

// ═══════════════════ 3. BOUTIQUES ═══════════════════
// Boutique = identité + coordonnées + légal + caches de lecture.
// Le contenu éditorial/SEO par langue vit dans BoutiqueLocalization,
// les scores détaillés dans SellerScoreSnapshot.

model Boutique {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId String @unique @db.Uuid
  owner   User   @relation("BoutiqueOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  name String @unique
  slug String @unique @db.VarChar(120)

  // [COMPAT] Contenu par défaut (FR). Source de vérité = BoutiqueLocalization.
  tagline         String?  @db.VarChar(160)
  description     String?  @db.Text
  longDescription String?  @db.Text
  story           String?  @db.Text
  values          String?  @db.Text
  bio             String?
  metaTitle       String?  @db.VarChar(70)
  metaDescription String?  @db.VarChar(160)
  metaKeywords    String[] @default([])
  canonicalUrl    String?
  ogImageUrl      String?
  noIndex         Boolean  @default(false)

  logoUrl     String?
  coverUrl    String?
  galleryUrls String[] @default([])

  province  ProvinceMadagascar?
  region    RegionMadagascar?
  city      String?
  address   String?
  latitude  Float?
  longitude Float?

  contactEmail   String?
  contactPhone   String?
  websiteUrl     String?
  facebookUrl    String?
  instagramUrl   String?
  tiktokUrl      String?
  whatsappNumber String?
  linkedinUrl    String?

  legalName               String?
  legalRegistrationNumber String?
  taxId                   String?
  isVerified              Boolean   @default(false)
  verifiedAt              DateTime?
  verifiedBy              String?   @db.Uuid
  trustLevel              Int       @default(0)

  returnPolicy       String? @db.Text
  shippingPolicy     String? @db.Text
  warrantyPolicy     String? @db.Text
  processingTimeDays Int?

  storeCategoryId String?   @db.Uuid
  storeCategory   Category? @relation("BoutiqueStoreCategory", fields: [storeCategoryId], references: [id], onDelete: SetNull)

  // Caches de lecture (écrits UNIQUEMENT par les jobs, jamais par l'API)
  ratingCache          Float @default(0)
  reviewCountCache     Int   @default(0)
  subscriberCountCache Int   @default(0)
  productCountCache    Int   @default(0)
  salesCountCache      Int   @default(0)
  viewCountCache       Int   @default(0)
  favoriteCountCache   Int   @default(0)
  scoreTotal           Float @default(0)
  seoScoreCache        Float @default(0)
  contentScoreCache    Float @default(0)

  lastProductAt       DateTime?
  lastOrderAt         DateTime?
  lastReviewAt        DateTime?
  lastActiveAt        DateTime?
  responseTimeMinutes Int?

  tier SellerTier @default(BRONZE)

  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  isSuspended     Boolean   @default(false)
  suspendedReason String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  managers      ManagedBoutique[]
  products      Product[]
  subscriptions Subscription[]
  feedbacks     Feedback[]

  localizations  BoutiqueLocalization[]
  posts          BoutiquePost[]
  seoAudits      SeoAudit[]
  dailyStats     BoutiqueDailyStat[]
  scoreSnapshots SellerScoreSnapshot[]

  stats              SellerStats[]
  leaderboardEntries SellerLeaderboardEntry[]
  premiumAccesses    SellerPremiumAccess[]
  rewards            SellerReward[]
  achievements       SellerAchievementAward[]
  promotions         SellerPromotion[]

  @@index([storeCategoryId])
  @@index([isActive, deletedAt])
  @@index([isFeatured, scoreTotal(sort: Desc)])
  @@index([scoreTotal(sort: Desc)])
  @@index([seoScoreCache(sort: Desc)])
  @@index([ratingCache(sort: Desc)])
  @@index([subscriberCountCache(sort: Desc)])
  @@index([province, region])
  @@index([publishedAt])
  @@map("boutiques")
}

model ManagedBoutique {
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  boutiqueId String   @db.Uuid
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  role       String?
  createdAt  DateTime @default(now())

  @@id([userId, boutiqueId])
  @@index([boutiqueId])
  @@map("managed_boutiques")
}

model Subscription {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  boutiqueId String   @db.Uuid
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([userId, boutiqueId])
  @@index([boutiqueId])
  @@index([userId])
  @@map("subscriptions")
}

// ═══════════════════ 4. ADRESSES & LOGISTIQUE ═══════════════════

model Address {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String             @db.Uuid
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String
  fullName       String
  phone          String
  email          String?
  province       ProvinceMadagascar
  region         RegionMadagascar
  city           String
  neighborhood   String?
  address        String
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  notes          String?
  isDefault      Boolean            @default(false)

  pickupPointId String?      @db.Uuid
  pickupPoint   PickupPoint? @relation(fields: [pickupPointId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([province, region])
  @@map("addresses")
}

model PickupPoint {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  provider       String
  phone          String?
  email          String?
  province       ProvinceMadagascar
  region         RegionMadagascar
  city           String
  address        String
  latitude       Float?
  longitude      Float?
  shippingZoneId String?            @db.Uuid
  shippingZone   ShippingZone?      @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  addresses Address[]
  orders    Order[]

  @@index([province, region])
  @@index([provider])
  @@index([isActive])
  @@map("pickup_points")
}

model ShippingZone {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String              @unique
  province      ProvinceMadagascar?
  regions       RegionMadagascar[]
  basePrice     Int
  pricePerKg    Int?
  estimatedDays Int?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  orders       Order[]
  pickupPoints PickupPoint[]

  @@index([province])
  @@map("shipping_zones")
}

model DeliveryTracking {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String  @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierId String? @db.Uuid
  courier   User?   @relation("DeliveryCourier", fields: [courierId], references: [id], onDelete: SetNull)

  latitude   Float
  longitude  Float
  accuracy   Float?
  speed      Float?
  heading    Float?
  recordedAt DateTime @default(now())

  @@index([orderId, recordedAt])
  @@index([courierId, recordedAt])
  @@map("delivery_tracking")
}

// ═══════════════════ 5. CATALOGUE ═══════════════════

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String   @unique
  description String
  imageUrl    String
  bannerUrl   String
  iconName    String   @default("ShoppingBag")
  position    Int      @default(0)

  // Hiérarchie (arbre de catégories)
  parentId String?    @db.Uuid
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  depth    Int        @default(0)
  path     String     @default("") // "artisanat/vannerie/paniers"
  isActive Boolean    @default(true)

  // SEO catégorie
  metaTitle       String? @db.VarChar(70)
  metaDescription String? @db.VarChar(160)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  ProductCategory[]
  boutiques Boutique[]        @relation("BoutiqueStoreCategory")

  @@index([parentId])
  @@index([isActive, position])
  @@map("categories")
}

model Product {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boutiqueId String   @db.Uuid
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  slug       String   @unique
  sku        String   @unique

  // [COMPAT] Contenu par défaut (FR). Source de vérité = ProductLocalization.
  title           String
  description     String?
  longDescription String?

  // ── Prix ──
  pricingMode ProductPricingMode @default(FIXED)
  price       Int?
  originalPrice Int?
  minPrice    Int?
  maxPrice    Int?

  // ── Enchères (à extraire plus tard dans un modèle Auction) ──
  auctionStartPrice   Int?
  auctionReservePrice Int?
  auctionCurrentPrice Int?
  auctionStartAt      DateTime?
  auctionEndAt        DateTime?
  auctionStatus       AuctionStatus? // null = pas une enchère (ancien default ACTIVE supprimé)
  auctionWinnerId     String?        @db.Uuid
  auctionWinner       User?          @relation("AuctionWinner", fields: [auctionWinnerId], references: [id], onDelete: SetNull)
  auctionFinalPrice   Int?
  auctionBidCount     Int            @default(0)
  auctionWatcherCount Int            @default(0)

  // ── Stock & état ──
  stock             Int     @default(0)
  lowStockThreshold Int     @default(5)
  isActive          Boolean @default(true)
  isNew             Boolean @default(false)

  // Caches de lecture (écrits par les jobs)
  ratingCache       Float @default(0)
  reviewCountCache  Int   @default(0)
  seoScoreCache     Float @default(0)
  contentScoreCache Float @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations catalogue
  images     ProductImage[]
  colors     ProductColor[]
  sizes      ProductSize[]
  categories ProductCategory[]

  // Contenu & SEO
  localizations ProductLocalization[]
  attributes    ProductAttribute[]
  faqs          ProductFaq[]
  tags          ProductTag[]
  dailyStats    ProductDailyStat[]

  // Commerce
  cartItems        CartItem[]
  favorites        FavoriteItem[]
  orderItems       OrderItem[]
  feedbacks        Feedback[]
  deletionRequests ProductDeletionRequest[]

  // Enchères
  bids            ProductBid[]
  auctionMessages AuctionMessage[]
  auctionWatchers AuctionWatcher[]

  @@index([boutiqueId, isActive, deletedAt])
  @@index([isActive, seoScoreCache(sort: Desc)])
  @@index([price])
  @@index([createdAt])
  @@index([stock])
  @@index([pricingMode, auctionStatus])
  @@index([auctionEndAt])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)

  // SEO images + performance
  altText   String?  @db.VarChar(200)
  width     Int?
  height    Int?
  blurHash  String?
  isPrimary Boolean  @default(false)

  @@index([productId])
  @@map("product_images")
}

model ProductColor {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  hex       String

  cartItems CartItem[]

  @@index([productId])
  @@map("product_colors")
}

model ProductSize {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  value     String  @db.VarChar(60)

  cartItems CartItem[]

  @@unique([productId, value])
  @@map("product_sizes")
}

model ProductCategory {
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

// Attributs structurés (matière, origine, poids...) → filtres + données structurées
model ProductAttribute {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String  @db.VarChar(60)
  value     String  @db.VarChar(200)
  unit      String? @db.VarChar(20)
  position  Int     @default(0)

  @@unique([productId, key])
  @@index([key, value])
  @@map("product_attributes")
}

model ProductFaq {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String        @db.Uuid
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale    ContentLocale @default(FR)
  question  String        @db.VarChar(300)
  answer    String        @db.Text
  position  Int           @default(0)

  @@index([productId, locale])
  @@map("product_faqs")
}

model Tag {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now())
  products  ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String  @db.Uuid
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

// ── Enchères ──

model ProductBid {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  proposedPrice Int
  comment       String?
  status        BidStatus @default(PENDING)

  isAutoBid    Boolean @default(false)
  autoBidMax   Int?
  isWinningBid Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, proposedPrice(sort: Desc)])
  @@index([userId])
  @@index([productId, status])
  @@index([productId, isWinningBid])
  @@map("product_bids")
}

model AuctionMessage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String? @db.Uuid
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type     AuctionMessageType @default(CHAT)
  content  String             @db.Text
  metadata Json?

  isDeleted Boolean   @default(false)
  deletedBy String?   @db.Uuid
  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([productId, type])
  @@index([userId])
  @@map("auction_messages")
}

model AuctionWatcher {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())
  isActive   Boolean  @default(true)

  @@unique([productId, userId])
  @@index([productId, isActive])
  @@index([lastSeenAt])
  @@map("auction_watchers")
}

// ── Panier & favoris ──

model CartItem {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String        @db.Uuid
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId   String?       @db.Uuid
  color     ProductColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)
  sizeId    String?       @db.Uuid
  size      ProductSize?  @relation(fields: [sizeId], references: [id], onDelete: SetNull)

  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, colorId, sizeId])
  @@index([userId])
  @@map("cart_items")
}

model FavoriteItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("favorite_items")
}

// ═══════════════════ 6. CONTENU & SEO ═══════════════════

// Contenu + SEO d'un produit dans UNE langue.
model ProductLocalization {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String        @db.Uuid
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale    ContentLocale

  // Contenu
  title            String
  shortDescription String? @db.VarChar(300)
  description      String? @db.Text
  longDescription  String? @db.Text

  // SEO
  metaTitle       String?  @db.VarChar(70)
  metaDescription String?  @db.VarChar(160)
  focusKeyword    String?  @db.VarChar(80)
  keywords        String[] @default([])
  canonicalUrl    String?
  ogImageUrl      String?
  noIndex         Boolean  @default(false)

  // Mesures calculées par job (jamais saisies à la main)
  wordCount        Int     @default(0)
  readabilityScore Float?
  contentHash      String? @db.VarChar(64) // détection de contenu dupliqué

  moderationStatus ModerationStatus @default(APPROVED)
  moderatedBy      String?          @db.Uuid
  moderatedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, locale])
  @@index([locale, moderationStatus])
  @@index([contentHash])
  @@map("product_localizations")
}

model BoutiqueLocalization {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boutiqueId String        @db.Uuid
  boutique   Boutique      @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  locale     ContentLocale

  tagline         String? @db.VarChar(160)
  description     String? @db.Text
  longDescription String? @db.Text
  story           String? @db.Text
  values          String? @db.Text

  metaTitle       String?  @db.VarChar(70)
  metaDescription String?  @db.VarChar(160)
  focusKeyword    String?  @db.VarChar(80)
  keywords        String[] @default([])
  canonicalUrl    String?
  ogImageUrl      String?
  noIndex         Boolean  @default(false)

  wordCount        Int              @default(0)
  moderationStatus ModerationStatus @default(APPROVED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boutiqueId, locale])
  @@map("boutique_localizations")
}

// Contenu éditorial vendeur (blog, guides) = levier SEO long terme
model BoutiquePost {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boutiqueId String        @db.Uuid
  boutique   Boutique      @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  locale     ContentLocale @default(FR)

  slug     String  @db.VarChar(160)
  title    String  @db.VarChar(200)
  excerpt  String? @db.VarChar(300)
  content  String  @db.Text
  coverUrl String?

  metaTitle       String? @db.VarChar(70)
  metaDescription String? @db.VarChar(160)
  focusKeyword    String? @db.VarChar(80)

  status           PostStatus       @default(DRAFT)
  moderationStatus ModerationStatus @default(PENDING)
  publishedAt      DateTime?
  wordCount        Int              @default(0)
  viewCountCache   Int              @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([boutiqueId, slug])
  @@index([status, publishedAt(sort: Desc)])
  @@map("boutique_posts")
}

// 301 automatique quand un slug change (conserve le référencement)
model SlugRedirect {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType SeoEntityType
  entityId   String        @db.Uuid
  oldSlug    String
  createdAt  DateTime      @default(now())

  @@unique([entityType, oldSlug])
  @@index([entityType, entityId])
  @@map("slug_redirects")
}

// Audit SEO : un audit = une entité à un instant T, avec liste d'actions
model SeoAudit {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boutiqueId String        @db.Uuid
  boutique   Boutique      @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  entityType SeoEntityType
  entityId   String        @db.Uuid
  locale     ContentLocale @default(FR)

  seoScore     Float // 0-100
  contentScore Float // 0-100
  issueCount   Int     @default(0)

  ruleSetId  String?         @db.Uuid
  ruleSet    ScoringRuleSet? @relation(fields: [ruleSetId], references: [id], onDelete: SetNull)
  isLatest   Boolean         @default(true)
  computedAt DateTime        @default(now())

  issues SeoIssue[]

  @@index([entityType, entityId, isLatest])
  @@index([boutiqueId, entityType, isLatest])
  @@index([computedAt])
  @@map("seo_audits")
}

model SeoIssue {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auditId  String           @db.Uuid
  audit    SeoAudit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  code     SeoIssueCode
  severity SeoIssueSeverity
  field    String?
  message  String?

  @@index([auditId])
  @@index([code, severity])
  @@map("seo_issues")
}

// ═══════════════════ 7. COMMANDES & PAIEMENTS ═══════════════════

model Order {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber   String        @unique
  userId        String        @db.Uuid
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  currency      String        @default("MGA")

  deliveryMode DeliveryMode

  shippingFullName     String
  shippingPhone        String
  shippingEmail        String
  shippingProvince     ProvinceMadagascar
  shippingRegion       RegionMadagascar
  shippingCity         String
  shippingNeighborhood String?
  shippingAddress      String
  shippingNotes        String?

  deliveryLatitude    Float?
  deliveryLongitude   Float?
  deliveryAccuracy    Float?
  deliveryGpsSharedAt DateTime?

  shippingZoneId        String?       @db.Uuid
  shippingZone          ShippingZone? @relation(fields: [shippingZoneId], references: [id])
  shippingPickupPointId String?       @db.Uuid
  shippingPickupPoint   PickupPoint?  @relation(fields: [shippingPickupPointId], references: [id], onDelete: SetNull)

  subtotal     Int
  shippingCost Int
  total        Int

  codAmountExpected Int?
  codCollectedAt    DateTime?
  codCollectedBy    String?

  paidAt             DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  refundedAt         DateTime?
  reviewRequestedAt  DateTime?
  stockReservedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items            OrderItem[]
  transactions     Transaction[]
  feedbacks        Feedback[]
  settlements      SellerSettlement[]
  deliveryTracking DeliveryTracking[]

  @@index([userId])
  @@index([status])
  @@index([status, createdAt(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([deliveryMode, status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String  @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Dénormalisé : stats et règlements par vendeur sans passer par Product.
  // Nullable le temps du backfill ; passer en NOT NULL ensuite.
  boutiqueId String? @db.Uuid

  titleSnapshot String
  imageSnapshot String?
  skuSnapshot   String
  priceSnapshot Int
  colorSnapshot String?
  sizeSnapshot  String?
  quantity      Int

  feedbacks Feedback[]

  @@index([orderId])
  @@index([productId])
  @@index([boutiqueId])
  @@map("order_items")
}

model Transaction {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount            Int
  currency          String               @default("MGA")
  method            PaymentMethod
  provider          MobileMoneyProvider?
  status            TransactionStatus
  externalId        String?              @unique
  externalRequestId String?
  idempotencyKey    String               @unique
  rawCallback       Json?
  signatureVerified Boolean              @default(false)
  failureReason     String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([orderId])
  @@index([status])
  @@map("transactions")
}

model PaymentWebhook {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider     MobileMoneyProvider
  externalId   String?
  eventType    String
  rawPayload   Json
  signature    String?
  verified     Boolean             @default(false)
  processedAt  DateTime?
  errorMessage String?
  receivedAt   DateTime            @default(now())

  @@index([provider, externalId])
  @@index([processedAt])
  @@map("payment_webhooks")
}

// ═══════════════════ 8. FEEDBACK UNIFIÉ ═══════════════════
// À ajouter dans une migration SQL (CHECK) :
//   type='PRODUCT'  => productId  NOT NULL
//   type='BOUTIQUE' => boutiqueId NOT NULL
//   type='SERVICE'  => period     NOT NULL

model Feedback {
  id     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String       @db.Uuid
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   FeedbackType

  // PRODUCT
  productId   String?    @db.Uuid
  product     Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId     String?    @db.Uuid
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItemId String?    @db.Uuid
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  // BOUTIQUE
  boutiqueId String?   @db.Uuid
  boutique   Boutique? @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  // SERVICE
  period String?

  // Commun
  rating   Int
  title    String?
  comment  String            @db.Text
  criteria Json?
  category FeedbackCategory?

  isApproved      Boolean   @default(false)
  approvedBy      String?   @db.Uuid
  approvedAt      DateTime?
  rejectedBy      String?   @db.Uuid
  rejectedAt      DateTime?
  rejectionReason String?
  teamResponse    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, productId])
  @@unique([userId, boutiqueId])
  @@unique([userId, period])
  @@index([productId, isApproved])
  @@index([boutiqueId, isApproved])
  @@index([userId, type])
  @@index([type, isApproved, createdAt])
  @@index([orderId])
  @@index([deletedAt])
  @@map("feedbacks")
}

// ═══════════════════ 9. NOTIFICATIONS & MESSAGES ═══════════════════

model Notification {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String           @db.Uuid
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  title        String
  message      String
  actionUrl    String
  imageUrl     String?
  referenceKey String
  read         Boolean          @default(false)
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  @@unique([userId, referenceKey])
  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

model UserMessage {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String      @db.Uuid
  recipient   User        @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  senderId    String?     @db.Uuid
  sender      User?       @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  type        MessageType @default(ADMIN_MESSAGE)
  subject     String
  body        String
  read        Boolean     @default(false)
  readAt      DateTime?
  createdAt   DateTime    @default(now())

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
  @@map("user_messages")
}

model AdminNotification {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        AdminNotificationType
  title       String
  message     String
  entityType  String
  entityId    String
  actorUserId String?
  priority    Int                   @default(0)
  read        Boolean               @default(false)
  readAt      DateTime?
  createdAt   DateTime              @default(now())

  @@index([read, createdAt])
  @@index([entityType, entityId])
  @@map("admin_notifications")
}

model NewsletterSubscriber {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique
  confirmationToken String?   @unique
  confirmedAt       DateTime?
  unsubscribedAt    DateTime?
  unsubscribeReason String?
  createdByIp       String?
  subscribedAt      DateTime  @default(now())

  @@index([confirmedAt])
  @@map("newsletter_subscribers")
}

// ═══════════════════ 10. BUSINESS VENDEUR ═══════════════════

model SellerContract {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId        String               @db.Uuid
  seller          User                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  version         Int
  type            SellerContractType
  value           Int
  currency        String               @default("MGA")
  status          SellerContractStatus @default(PENDING)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  rejectionReason String?
  reviewedBy      String?              @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  settlements SellerSettlement[]

  @@unique([sellerId, version])
  @@index([sellerId, status, effectiveFrom])
  @@map("seller_contracts")
}

model SellerSettlement {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String           @db.Uuid
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId         String           @db.Uuid
  seller           User             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  contractId       String?          @db.Uuid
  contract         SellerContract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  contractVersion  Int?
  grossAmount      Int
  commissionAmount Int
  netAmount        Int
  status           SettlementStatus @default(PENDING_REVIEW)
  reviewNote       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  transfers TransferLedger[]

  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt])
  @@index([orderId])
  @@map("seller_settlements")
}

model TransferLedger {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlementId      String           @db.Uuid
  settlement        SellerSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  sellerId          String           @db.Uuid
  seller            User             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  amount            Int
  currency          String           @default("MGA")
  idempotencyKey    String           @unique
  status            TransferStatus   @default(PENDING)
  externalReference String?
  failureReason     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  completedAt       DateTime?

  @@index([sellerId, status, createdAt])
  @@index([settlementId])
  @@map("transfer_ledger")
}

// ═══════════════════ 11. ADMIN, AUDIT, MÉDIA ═══════════════════

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @db.Uuid
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model MediaAsset {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId             String             @db.Uuid
  owner               User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceUrl           String             @db.Text
  publicUrl           String             @db.Text
  githubPath          String             @db.Text
  contentType         String             @db.VarChar(100)
  byteSize            Int
  githubSha           String?            @db.VarChar(100)
  googleArchiveStatus MediaArchiveStatus @default(NOT_CONFIGURED)
  googleArchiveError  String?            @db.Text
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([ownerId, createdAt])
  @@index([googleArchiveStatus])
  @@map("media_assets")
}

// Chaque job (scores, audits, stats) s'enregistre ici : pas de double
// exécution, et on sait ce qui a échoué.
model JobRun {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String // "compute-daily-stats", "compute-scores", "seo-audit"
  runKey     String // "2026-10-07", "2026-W41"
  status     JobStatus @default(RUNNING)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  processed  Int       @default(0)
  error      String?   @db.Text
  meta       Json?

  @@unique([name, runKey])
  @@index([name, status, startedAt(sort: Desc)])
  @@map("job_runs")
}

// ═══════════════════ 12. CONFIGURATION PLATEFORME ═══════════════════

model PlatformSettings {
  id String @id @default("singleton")

  siteName        String @default("Lurevia")
  siteTagline     String @default("Artisanat malgache authentique")
  siteDescription String @default("Découvrez l'artisanat malgache fait main")
  contactEmail    String @default("contact@lurevia.mg")
  contactPhone    String @default("+261 34 12 345 67")
  contactAddress  String @default("Antananarivo, Madagascar")
  defaultCurrency String @default("MGA")

  logoUrl        String?
  faviconUrl     String?
  primaryColor   String  @default("#2F7BF6")
  secondaryColor String  @default("#0A1B3D")
  accentColor    String  @default("#E8A33D")

  facebookUrl    String?
  instagramUrl   String?
  tiktokUrl      String?
  whatsappNumber String?
  linkedinUrl    String?

  privacyPolicy           String  @default("") @db.Text
  termsOfService          String  @default("") @db.Text
  cookieMessage           String  @default("Nous utilisons des cookies pour améliorer votre expérience.") @db.Text
  legalCompanyName        String  @default("Lurevia SARL")
  legalRegistrationNumber String?

  freeShippingThreshold Int     @default(250000)
  defaultShippingCost   Int     @default(8000)
  homeDeliveryEnabled   Boolean @default(true)
  pickupPointEnabled    Boolean @default(true)

  enableMVola         Boolean @default(true)
  enableCOD           Boolean @default(true)
  enableCard          Boolean @default(false)
  enableBankTransfer  Boolean @default(false)
  mvolaMerchantNumber String?
  codMaxAmount        Int?

  requireCinForSellers   Boolean @default(true)
  requireCinForCOD       Boolean @default(false)
  cinVerificationEnabled Boolean @default(true)
  allowMinorWithGuardian Boolean @default(true)
  minorAgeThreshold      Int     @default(18)

  auctionsEnabled          Boolean @default(true)
  auctionMinIncrement      Int     @default(1000)
  auctionAutoExtendMinutes Int     @default(2)
  auctionDefaultDurationH  Int     @default(24)
  auctionChatEnabled       Boolean @default(true)
  auctionChatModeration    Boolean @default(true)

  notifyOnNewOrder         Boolean @default(true)
  notifyOnNewReview        Boolean @default(true)
  notifyOnLowStock         Boolean @default(true)
  lowStockThreshold        Int     @default(5)
  sendOrderConfirmation    Boolean @default(true)
  sendShippingNotification Boolean @default(true)

  metaTitle       String?
  metaDescription String?

  maintenanceMode    Boolean @default(false)
  maintenanceMessage String  @default("") @db.Text

  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@map("platform_settings")
}

model SitePage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String   @unique @db.VarChar(80)
  title         String   @db.VarChar(200)
  summary       String   @default("") @db.Text
  content       String   @default("") @db.Text
  published     Boolean  @default(false)
  showInFooter  Boolean  @default(false)
  footerSection String?  @db.VarChar(20)
  updatedBy     String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, showInFooter])
  @@map("site_pages")
}

// ═══════════════ 13. MESURES, SCORING, CLASSEMENTS, RÉCOMPENSES ═══════════════

// ── 13.1 Mesures journalières (faits agrégés, append-only) ──
// Les événements bruts (chaque vue/clic) restent hors base (ou table
// partitionnée) ; on ne garde ici que l'agrégat du jour.

model ProductDailyStat {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  boutiqueId String   @db.Uuid // dénormalisé : agrégation vendeur sans jointure
  date       DateTime @db.Date

  impressions  Int    @default(0)
  clicks       Int    @default(0)
  views        Int    @default(0)
  uniqueViews  Int    @default(0)
  organicViews Int    @default(0) // venues des moteurs de recherche
  addToCart    Int    @default(0)
  favorites    Int    @default(0)
  orders       Int    @default(0)
  unitsSold    Int    @default(0)
  revenue      BigInt @default(0)
  avgPosition  Float? // position moyenne dans la recherche interne

  @@unique([productId, date])
  @@index([boutiqueId, date])
  @@index([date])
  @@map("product_daily_stats")
}

model BoutiqueDailyStat {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boutiqueId String   @db.Uuid
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date

  views              Int    @default(0)
  uniqueViews        Int    @default(0)
  organicViews       Int    @default(0)
  newSubscribers     Int    @default(0)
  lostSubscribers    Int    @default(0)
  orders             Int    @default(0)
  revenue            BigInt @default(0)
  messagesReceived   Int    @default(0)
  messagesAnswered   Int    @default(0)
  avgResponseMinutes Int?

  @@unique([boutiqueId, date])
  @@index([date])
  @@map("boutique_daily_stats")
}

// Ce que cherchent les clients → guide les vendeurs sur les bons mots-clés
model SearchTermDailyStat {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  term       String        @db.VarChar(120)
  locale     ContentLocale @default(FR)
  date       DateTime      @db.Date
  searches   Int           @default(0)
  zeroResult Int           @default(0)
  clicks     Int           @default(0)

  @@unique([term, locale, date])
  @@index([date, searches(sort: Desc)])
  @@map("search_term_daily_stats")
}

// ── 13.2 Statistiques business par période ──

model SellerStats {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boutiqueId String   @db.Uuid
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  period    LeaderboardPeriod
  periodKey String // "2026-W42", "2026-10", "2026-Q4", "2026"
  startsAt  DateTime
  endsAt    DateTime

  totalRevenue    Int   @default(0)
  totalOrders     Int   @default(0)
  completedOrders Int   @default(0)
  cancelledOrders Int   @default(0)
  returnedOrders  Int   @default(0)
  disputedOrders  Int   @default(0)
  avgOrderValue   Float @default(0)

  avgRating       Float @default(0)
  totalReviews    Int   @default(0)
  fiveStarReviews Int   @default(0)

  avgResponseMinutes Int?  @default(0)
  onTimeDeliveryRate Float @default(0)
  cancellationRate   Float @default(0)
  returnRate         Float @default(0)
  disputeRate        Float @default(0)

  newSubscribers  Int @default(0)
  lostSubscribers Int @default(0)
  newProducts     Int @default(0)
  totalViews      Int @default(0)

  // Le score détaillé vit dans SellerScoreSnapshot ; ces 3 champs
  // restent par compatibilité avec le code existant.
  scoreTotal Float      @default(0)
  rank       Int?
  tier       SellerTier @default(BRONZE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boutiqueId, period, periodKey])
  @@index([period, periodKey, scoreTotal(sort: Desc)])
  @@index([period, periodKey, rank])
  @@index([boutiqueId, period])
  @@map("seller_stats")
}

// ── 13.3 Scoring versionné ──

model ScoringRuleSet {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version Int    @unique
  name    String

  weightSeo        Float @default(0.25)
  weightContent    Float @default(0.20)
  weightTrust      Float @default(0.20)
  weightEngagement Float @default(0.15)
  weightQuality    Float @default(0.15)
  weightRecency    Float @default(0.05)

  params     Json? // seuils : longueur titre idéale, nb images min...
  isActive   Boolean   @default(false)
  activeFrom DateTime?
  createdBy  String?   @db.Uuid
  createdAt  DateTime  @default(now())

  audits    SeoAudit[]
  snapshots SellerScoreSnapshot[]

  @@index([isActive])
  @@map("scoring_rule_sets")
}

model SellerScoreSnapshot {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boutiqueId String            @db.Uuid
  boutique   Boutique          @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  period     LeaderboardPeriod
  periodKey  String
  ruleSetId  String            @db.Uuid
  ruleSet    ScoringRuleSet    @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)

  scoreSeo        Float @default(0)
  scoreContent    Float @default(0)
  scoreTrust      Float @default(0)
  scoreEngagement Float @default(0)
  scoreQuality    Float @default(0)
  scoreRecency    Float @default(0)
  scoreTotal      Float @default(0)
  rank            Int?
  breakdown       Json? // détail explicable : "pourquoi j'ai ce score"

  computedAt DateTime @default(now())

  @@unique([boutiqueId, period, periodKey, ruleSetId])
  @@index([period, periodKey, scoreTotal(sort: Desc)])
  @@index([boutiqueId, period])
  @@map("seller_score_snapshots")
}

// ── 13.4 Classements officiels ──

model SellerLeaderboard {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  period    LeaderboardPeriod
  periodKey String
  scope     LeaderboardScope  @default(GLOBAL)
  scopeKey  String            @default("ALL") // categoryId, province... (plus de NULL : unicité fiable)
  metric    ScoreComponent    @default(TOTAL) // "meilleur SEO", "meilleur contenu"...

  startsAt DateTime
  endsAt   DateTime

  publishedAt DateTime?
  isFinalized Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries SellerLeaderboardEntry[]

  @@unique([period, periodKey, scope, scopeKey, metric])
  @@index([period, periodKey, scope])
  @@map("seller_leaderboards")
}

model SellerLeaderboardEntry {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaderboardId String            @db.Uuid
  leaderboard   SellerLeaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  boutiqueId String   @db.Uuid
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  rank       Int
  scoreTotal Float
  tier       SellerTier @default(BRONZE)

  totalRevenue Int   @default(0)
  totalOrders  Int   @default(0)
  avgRating    Float @default(0)
  totalReviews Int   @default(0)

  isWinner Boolean @default(false)

  reward SellerReward?

  createdAt DateTime @default(now())

  @@unique([leaderboardId, boutiqueId])
  @@index([leaderboardId, rank])
  @@index([boutiqueId])
  @@map("seller_leaderboard_entries")
}

// ── 13.5 Fonctionnalités premium ──

model PremiumFeature {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         PremiumFeatureCode @unique
  name         String
  description  String             @db.Text
  iconName     String?
  durationDays Int                @default(7)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  accesses SellerPremiumAccess[]
  rewards  SellerReward[]

  @@map("premium_features")
}

model SellerPremiumAccess {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boutiqueId String         @db.Uuid
  boutique   Boutique       @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  featureId  String         @db.Uuid
  feature    PremiumFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  source    String? // "LEADERBOARD", "ADMIN_GRANT", "PROMOTION"
  reason    String?
  grantedAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boutiqueId, isActive])
  @@index([featureId, isActive])
  @@index([expiresAt])
  @@map("seller_premium_access")
}

// ── 13.6 Récompenses ──

model SellerReward {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boutiqueId String   @db.Uuid
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  type        RewardType
  status      RewardStatus @default(PENDING)
  title       String
  description String?      @db.Text
  value       Int?
  currency    String?      @default("MGA")

  featureId String?         @db.Uuid
  feature   PremiumFeature? @relation(fields: [featureId], references: [id], onDelete: SetNull)

  leaderboardEntryId String?                 @unique @db.Uuid
  leaderboardEntry   SellerLeaderboardEntry? @relation(fields: [leaderboardEntryId], references: [id], onDelete: SetNull)

  achievementAwardId String?                 @unique @db.Uuid
  achievementAward   SellerAchievementAward? @relation(fields: [achievementAwardId], references: [id], onDelete: SetNull)

  grantedAt    DateTime?
  expiresAt    DateTime?
  usedAt       DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boutiqueId, status])
  @@index([type, status])
  @@index([expiresAt])
  @@map("seller_rewards")
}

// ── 13.7 Badges / achievements ──

model Achievement {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        AchievementCode   @unique
  name        String
  description String            @db.Text
  iconName    String?
  rarity      AchievementRarity @default(COMMON)
  points      Int               @default(10)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())

  awards SellerAchievementAward[]

  @@map("achievements")
}

model SellerAchievementAward {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boutiqueId    String      @db.Uuid
  boutique      Boutique    @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  achievementId String      @db.Uuid
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  earnedAt  DateTime @default(now())
  periodKey String   @default("LIFETIME") // plus de NULL : un badge à vie ne peut plus être dupliqué
  metadata  Json?

  reward SellerReward?

  createdAt DateTime @default(now())

  @@unique([boutiqueId, achievementId, periodKey])
  @@index([boutiqueId])
  @@index([achievementId])
  @@map("seller_achievement_awards")
}

// ── 13.8 Promotions vendeur ──

model SellerPromotion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boutiqueId String   @db.Uuid
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  code            String  @unique
  title           String
  description     String? @db.Text
  discountPercent Int?
  discountAmount  Int?
  maxUses         Int?
  usedCount       Int     @default(0)
  minOrderAmount  Int?

  source    String?
  startsAt  DateTime
  expiresAt DateTime
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boutiqueId, isActive])
  @@map("seller_promotions")
}

